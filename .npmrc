# openapi-typescript@7 declares a peer range of typescript@^5.x, but it only
# calls the stable ts.factory AST API (verified: it generated our 9643-line
# schema.d.ts — 125 paths / 142 schemas — correctly under TS 6.0.3). The
# scaffold's TypeScript is 6.x, so a plain 'npm install'/'npm ci' fails with
# ERESOLVE on a peer range that is declared too narrow, not actually violated.
legacy-peer-deps=true
